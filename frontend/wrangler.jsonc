{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "weave-personal-planet",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "env": {
    "preview": {
      "name": "weave-personal-planet-preview",
      "vars": {
        "VAPID_PUBLIC_KEY": "BIB5tr4Hqj6zyXNcmG556J888tX_dvJnte5QvGK2YvWLESgfVdWz_IUDYw2OkumwhOO6GfusxGGpF1cYubSNLww",
        "VAPID_SUBJECT": "https://github.com/viewNan/Weave"
      },
      "d1_databases": [{
        "binding": "PUSH_SUBSCRIPTIONS_DB",
        "database_name": "weave-push-preview",
        "database_id": "a576845a-695a-484e-93f2-431716d50ff8",
        "migrations_dir": "migrations"
      }]
    }
  },
  "observability": {
    "enabled": true
  }
}
